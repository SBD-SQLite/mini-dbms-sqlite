        <mxCell id="m29_1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#ffffff;" value="txId: long; change: DataChange" vertex="1">
