        </mxCell>
        <mxCell id="m31_0" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#ffffff;" value="IFailureRecoveryManager.ensureDurable" vertex="1">
          <mxGeometry height="85" width="980" x="40" y="2765" as="geometry" />
        </mxCell>
        <mxCell id="m31_1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#ffffff;" value="lsn: long" vertex="1">
          <mxGeometry height="85" width="1180" x="1020" y="2765" as="geometry" />
        </mxCell>
        <mxCell id="m31_2" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#ffffff;" value="void" vertex="1">
          <mxGeometry height="85" width="620" x="2200" y="2765" as="geometry" />
        </mxCell>
        <mxCell id="m32_0" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#f5f9fc;" value="IFailureRecoveryManager.rollback" vertex="1">
          <mxGeometry height="85" width="980" x="40" y="2850" as="geometry" />
        </mxCell>
        <mxCell id="m32_1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#f5f9fc;" value="txId: long" vertex="1">
          <mxGeometry height="85" width="1180" x="1020" y="2850" as="geometry" />
        </mxCell>
        <mxCell id="m32_2" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#f5f9fc;" value="void" vertex="1">
          <mxGeometry height="85" width="620" x="2200" y="2850" as="geometry" />
        </mxCell>
        <mxCell id="m33_0" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#ffffff;" value="IFailureRecoveryManager.recover" vertex="1">
          <mxGeometry height="85" width="980" x="40" y="2935" as="geometry" />
        </mxCell>
        <mxCell id="m33_1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#ffffff;" value="—" vertex="1">
          <mxGeometry height="85" width="1180" x="1020" y="2935" as="geometry" />
        </mxCell>
        <mxCell id="m33_2" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#ffffff;" value="RecoveryResult" vertex="1">
          <mxGeometry height="85" width="620" x="2200" y="2935" as="geometry" />
        </mxCell>
        <mxCell id="m34_0" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#f5f9fc;" value="IFailureRecoveryManager.checkpoint" vertex="1">
          <mxGeometry height="85" width="980" x="40" y="3020" as="geometry" />
        </mxCell>
        <mxCell id="m34_1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#f5f9fc;" value="—" vertex="1">
          <mxGeometry height="85" width="1180" x="1020" y="3020" as="geometry" />
        </mxCell>
        <mxCell id="m34_2" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#f5f9fc;" value="void" vertex="1">
          <mxGeometry height="85" width="620" x="2200" y="3020" as="geometry" />
