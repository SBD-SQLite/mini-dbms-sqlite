  </diagram>
  <diagram name="04 Invariant dan Kesepakatan" id="t0-S7gIIWAdazXb39SK9">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2600" pageHeight="3000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="note2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="ATURAN KONTRAK &amp;amp; HAL YANG PERLU DISEPAKATI — pelengkap diagram, bukan tambahan kewajiban tugas" vertex="1">
          <mxGeometry height="70" width="2800" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="note3" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="1. Status dan ruang lingkup" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="130" as="geometry" />
        </mxCell>
        <mxCell id="note4" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="Draft v0.1 untuk diskusi supergroup. Mengikuti signature integrasi yang disusun sebelumnya, bukan audit atas source atau shared model terbaru masing-masing group. Usulan tipe tagged node memerlukan persetujuan QO/QP." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="172" as="geometry" />
        </mxCell>
        <mxCell id="note5" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="2. Identitas dan skalar" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="300" as="geometry" />
        </mxCell>
        <mxCell id="note6" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="txId, timestamp, LSN menggunakan long nonnegatif; nilai 0 berarti belum ada riwayat, ID/LSN nyata mulai 1. LSN urutan global log, bukan waktu. timestamp logis disamakan txId pada draft agar initAfterRecovery(lastTxId) tetap konsisten. String identifier tidak kosong; tableId stabil berbeda dari nama/alias." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="342" as="geometry" />
        </mxCell>
        <mxCell id="note7" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="3. Nilai dan schema" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="470" as="geometry" />
        </mxCell>
        <mxCell id="note8" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="INTEGER 32-bit signed; FLOAT binary64 finite. INTEGER-&amp;gt;FLOAT boleh untuk operasi campuran; overflow dan pembagian nol dilaporkan error. Perbandingan teks memakai aturan Unicode konsisten; panjang CHAR/VARCHAR dihitung code point. Detail padding CHAR dan pembulatan mesti disepakati SM/QO/QP. Value bukan boolean; hasil predicate boolean internal evaluator." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="512" as="geometry" />
        </mxCell>
        <mxCell id="note9" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="4. Optional dan NULL" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="640" as="geometry" />
        </mxCell>
        <mxCell id="note10" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="Optional berarti payload kontrak tidak tersedia, bukan SQL NULL. Dukungan SQL NULL tidak diasumsikan oleh draft wajib ini. Bila tim memerlukannya, tambah isNull dan aturan evaluasi secara eksplisit. RecordImage.exists=false berarti record tidak ada; values harus kosong." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="682" as="geometry" />
        </mxCell>
        <mxCell id="note11" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="5. Record, cursor dan hasil" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="810" as="geometry" />
        </mxCell>
        <mxCell id="note12" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="Record.values cocok dengan TableSchema.columns. ResultColumn/QueryResult memisahkan schema hasil dari Record fisik sehingga join tidak dipaksa memiliki satu RID. Jumlah nilai tiap row hasil sama dengan columns; SELECT kosong tetap punya header. Cursor harus ditutup dan tidak dikirim sebagai objek JSON antarproses tanpa adapter." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="852" as="geometry" />
        </mxCell>
        <mxCell id="note13" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="6. Expression dan plan" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="980" as="geometry" />
        </mxCell>
        <mxCell id="note14" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="LITERAL/COLUMN tanpa operands; UNARY satu operand, BINARY dua. Operator dan payload wajib sesuai kind. SCAN/INDEX_SCAN/INSERT/CREATE_INDEX tanpa child; FILTER/PROJECT/SORT/UPDATE/DELETE satu child; JOIN/CARTESIAN dua. INSERT satu baris; UPDATE satu kolom; predicate UPDATE/DELETE berada di child Filter. Slot payload node yang tidak relevan harus kosong." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="1022" as="geometry" />
        </mxCell>
        <mxCell id="note15" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="7. Plan setelah binding" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="note16" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="Referensi kolom sumber berqualifier untuk menghindari ambigu. PROJECT menjaga urutan SELECT; pushdown tetap mempertahankan kolom WHERE/JOIN/ORDER BY. NATURAL JOIN terikat dari katalog dan meniadakan kolom duplikat sesuai outputColumns. Hanya algoritma QP yang tersedia boleh muncul pada plan." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="1192" as="geometry" />
        </mxCell>
        <mxCell id="note17" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="8. ParsedQuery dan transaksi" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="note18" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="BEGIN/COMMIT/ABORT: transactionCommand terisi, root kosong, tidak dioptimasi. SELECT/DML/CREATE_INDEX: root terisi, transactionCommand kosong. Session hanya milik konteks QP/client; txId yang diteruskan ke layanan lain adalah ID CCM." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="1362" as="geometry" />
        </mxCell>
        <mxCell id="note19" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="9. Index" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="1490" as="geometry" />
        </mxCell>
        <mxCell id="note20" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="HASH hanya EQ. BPLUS_TREE EQ dan rentang; NE tidak langsung menjadi satu index lookup. BETWEEN adalah operasi internal, bukan janji sintaks SQL bonus. Batas bertipe kompatibel dengan key kolom. Lookup boleh mengembalikan banyak RID untuk key duplikat; no match adalah list kosong." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="1532" as="geometry" />
        </mxCell>
        <mxCell id="note21" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="10. WAL dan DataChange" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="note22" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="INSERT: before.exists=false, after=true. DELETE kebalikannya; UPDATE keduanya true. DataChange berisi satu record; txId diteruskan sebagai parameter logChange/requestWrite, bukan diduplikasi. RID log INSERT berasal reserveInsert sebelum mutasi. Read tidak menghasilkan changeLSN; perubahan dibuat log sebelum diterapkan; log persisten sebelum flush data/index." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="1702" as="geometry" />
        </mxCell>
        <mxCell id="note23" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="11. AccessResponse dan penantian" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="1830" as="geometry" />
        </mxCell>
        <mxCell id="note24" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="GRANTED write wajib changeLSN positif; GRANTED read changeLSN kosong. WAIT tidak mengizinkan mutasi. waitToken hanya dipakai jika tim menambahkan cara resume/poll/callback; interface sebelumnya belum menyediakan metode tunggu token. Pilihan sederhana adalah pemanggilan blocking yang tetap mencatat status WAIT untuk driver." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="1872" as="geometry" />
        </mxCell>
        <mxCell id="note25" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="12. Resource konkurensi" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="2000" as="geometry" />
        </mxCell>
        <mxCell id="note26" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="ResourceId TABLE mengosongkan rid; RECORD mewajibkan rid. CCM wajib menyepakati kompatibilitas table/record serta perlindungan scan/INSERT supaya schedule tetap serializable. Jangan menganggap representasi TABLE/RECORD otomatis menyelesaikan phantom atau lock hierarchy." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="2042" as="geometry" />
        </mxCell>
        <mxCell id="note27" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="13. Commit, abort dan error" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="2170" as="geometry" />
        </mxCell>
        <mxCell id="note28" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="COMMITTED hanya sesudah COMMIT log durable; ABORTED hanya sesudah undo selesai. CCM memanggil logAbort sesudah rollback sukses, hindari duplikasi pencatatan. logCommit/ensureDurable/restore gagal harus melempar error domain, bukan diam-diam sukses. Method tanpa response error memakai exception domain yang membawa ErrorInfo; QP menerjemahkannya ke QueryResult.ERROR." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="2212" as="geometry" />
        </mxCell>
        <mxCell id="note29" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="14. Recovery target" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="2340" as="geometry" />
        </mxCell>
        <mxCell id="note30" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="RecoveryTarget.TIME hanya time terisi; TRANSACTION hanya txId terisi dan wajib sudah commit. Target berdasarkan LSN COMMIT transaksi, bukan besar-kecil txId. Instant UTC untuk waktu commit, LSN sebagai pemecah timestamp sama. Target invalid ditolak sebelum data aktif diubah." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="2382" as="geometry" />
        </mxCell>
        <mxCell id="note31" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="15. Startup, checkpoint dan snapshot" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="2510" as="geometry" />
        </mxCell>
        <mxCell id="note32" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="RecoveryResult mengambil batas ID seluruh log valid. QP/CCM melayani transaksi hanya setelah recovery sukses; checkpoint memerlukan gerbang maintenance. Historical recovery perlu snapshot awal dan retensi log; API snapshot/restore offline beserta reset buffer/index/statistik masih harus disepakati FRM–SM." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="2552" as="geometry" />
        </mxCell>
        <mxCell id="note33" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="16. Bukan shared antarkomponen" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="2680" as="geometry" />
        </mxCell>
        <mxCell id="note34" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="BufferFrame, SlottedPage, node B+Tree, bucket Hash, log-file codec, lock table dan replacement state merupakan internal komponen. LogRecord tidak dimasukkan karena kontrak integrasi sekarang mengirim DataChange, bukan objek format log persisten. Menambah metode baca log lintas komponen berarti perlu tipe tambahan." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="2722" as="geometry" />
        </mxCell>
        <mxCell id="note35" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="17. Penyelarasan shared model tim" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="2850" as="geometry" />
        </mxCell>
        <mxCell id="note36" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="TableId/ReservationId pada rancangan SM lama dipetakan ke String pada draft keseluruhan ini; bila wrapper sudah dipakai tim, gunakan wrapper tersebut secara konsisten. RecordCursor pada rancangan lama lain bernama RowIterator: pilih satu nama atau adapter, jangan mendefinisikan dua kontrak berbeda tanpa pemetaan. Jangan langsung menimpa package shared yang sudah disepakati." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="2892" as="geometry" />
        </mxCell>
        <mxCell id="note37" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="18. Kepemilikan dan perubahan" vertex="1">
          <mxGeometry height="35" width="2800" x="50" y="3020" as="geometry" />
        </mxCell>
        <mxCell id="note38" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#455a64;" value="QO mengusulkan plan/ekspresi; SM mengusulkan schema/record/index/stats; CCM mengusulkan akses/transaksi; FRM mengusulkan recovery; QP mengusulkan hasil/sesi. Penyedia dan konsumen menyetujui field, tipe, invariant dan versi. Semua mock dan laporan memakai satu definisi yang sama." vertex="1">
          <mxGeometry height="110" width="2700" x="75" y="3062" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
