        <mxCell id="m30_0" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#f5f9fc;" value="IFailureRecoveryManager.logCommit / logAbort" vertex="1">
          <mxGeometry height="85" width="980" x="40" y="2680" as="geometry" />
        </mxCell>
        <mxCell id="m30_1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#f5f9fc;" value="txId: long" vertex="1">
          <mxGeometry height="85" width="1180" x="1020" y="2680" as="geometry" />
        </mxCell>
        <mxCell id="m30_2" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=14;strokeColor=#b0bec5;fillColor=#f5f9fc;" value="void" vertex="1">
